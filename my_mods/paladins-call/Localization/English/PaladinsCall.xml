<contentList xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- Crit Refund: Divine Abundance -->
  <content contentuid="h804b681cg7e44gb50bg8ee4g71c442632890" version="1">Divine Abundance</content>
  <content contentuid="h11245dc0gcb28g67d9gac62gce98b2c0dcc0" version="1">Landing a Critical Hit with a melee weapon infuses you with holy energy, immediately recovering an expended 1st-level spell slot.</content>

  <!-- Level 5: Righteous Strikes (1d6) -->
  <content contentuid="h1e5f10b7gb2e3g3ea5gdba5gc9a24ad875db" version="1">Righteous Strikes</content>
  <content contentuid="hd21b9d3dgd443g6daega543g5edb16a8a3e0" version="1">Your melee weapon attacks deal an additional 1d6 Radiant damage.</content>

  <!-- Level 8: Righteous Strikes (1d8) -->
  <content contentuid="h8b16f57dg75eeg237dg831ag80648b0f8eeb" version="1">Righteous Strikes</content>
  <content contentuid="h44e8fa5cg02bbg4090g8b5bgef05d2cabc5a" version="1">Your melee weapon attacks deal an additional 1d8 Radiant damage.</content>

  <!-- Level 11: Improved Divine Smite (1d10) -->
  <content contentuid="h1f1297b6ge365g9c89g9e92gb56e3a759d74" version="1">Improved Divine Smite</content>
  <content contentuid="h79637046gecc0g6c5dg607bgbd780533f63b" version="1">Your melee weapon attacks deal an additional 1d10 Radiant damage.</content>

  <!-- Level 15: Righteous Strikes Exalted (1d10 + CHA) -->
  <content contentuid="ha47c1df3gc51cgcfb3g9c18ga205acb26de6" version="1">Righteous Strikes: Exalted</content>
  <content contentuid="h42fc3075g24d8g0648ga9b3gd48c2d83368e" version="1">Your devotion channels overwhelming holy light. Your melee weapon attacks deal an additional 1d10 Radiant damage plus your Charisma Modifier.</content>

  <!-- Level 20: Righteous Strikes Apex (1d12 + CHA) -->
  <content contentuid="hdaccd62ag3eaeg8279g8458gaca5b30d17b8" version="1">Righteous Strikes: Apex</content>
  <content contentuid="hde521abdg01fdgaf4dg7dd5g8fd8db288e2a" version="1">You become an avatar of cosmic justice. Your melee weapon attacks deal an additional 1d12 Radiant damage plus your Charisma Modifier.</content>
</contentList>
