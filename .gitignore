# ==============================================================================
# Baldur's Gate 3 Mod Studio & Mod.io Toolkit - Git Ignore Rules
# ==============================================================================

# Secrets & Environment Configurations
.env
*.env
.env.*.local

# Python runtime & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.eggs/
.cache/

# Virtual Environments
.venv/
venv/
env/
ENV/

# IDE & Editor Files
.idea/
.vscode/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts, logs & archives
*.log
*.tmp
*.bak
*.pak
*.loca
*.zip

# Scratch / temporary experimental folders
scratch/

# Externalized User Content (Ignore any local studio folders or accidental spills)
build_guides/
mods/
my_mods/
BG3_Mod_Studio/
.agents/ledgers/artifacts-ledger.md
