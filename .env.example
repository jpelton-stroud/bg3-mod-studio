# ==============================================================================
# Baldur's Gate 3 Mod Studio & Mod.io Toolkit - Environment Variables
# ==============================================================================
# Copy this file to .env or run `./setup.sh` to configure interactively.

# ------------------------------------------------------------------------------
# mod.io API Credentials
# ------------------------------------------------------------------------------
# Get your API key and Personal Access Token (PAT) at: https://mod.io/me/access
MODIO_API_KEY=your_modio_api_key_here
MODIO_PAT=your_modio_pat_here

# ------------------------------------------------------------------------------
# Baldur's Gate 3 Game Paths
# ------------------------------------------------------------------------------
# Path to the Baldur's Gate 3 "Data" directory for syncing custom mods into the game.
# WSL Default:     /mnt/c/Program Files (x86)/Steam/steamapps/common/Baldurs Gate 3/Data
# Windows Default: C:\Program Files (x86)\Steam\steamapps\common\Baldurs Gate 3\Data
# Linux Default:   ~/.local/share/Steam/steamapps/common/Baldurs Gate 3/Data
BG3_DATA_DIR=/mnt/c/Program Files (x86)/Steam/steamapps/common/Baldurs Gate 3/Data

# ------------------------------------------------------------------------------
# Mod Author Metadata
# ------------------------------------------------------------------------------
# Default author name stamped into meta.lsx when generating new mod scaffolds.
# Leave blank or set to "default" if you prefer to specify per mod.
BG3_MOD_AUTHOR=default
